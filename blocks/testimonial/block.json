{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tunet/testimonial",
  "version": "0.1.0",
  "title": "Testimonial",
  "category": "design",
  "parent": ["tunet/testimonials"],
  "icon": "format-quote",
  "description": "A single testimonial: avatar, star rating, quote, name and role.",
  "keywords": ["testimonial", "review", "quote", "rating"],
  "textdomain": "tunet",
  "supports": {
    "html": false,
    "reusable": false,
    "inserter": false
  },
  "attributes": {
    "avatarId": { "type": "number", "default": 0 },
    "avatarUrl": { "type": "string", "default": "" },
    "rating": { "type": "number", "default": 0 },
    "quote": { "type": "string", "default": "" },
    "name": { "type": "string", "default": "" },
    "role": { "type": "string", "default": "" }
  },
  "editorScript": "file:./edit.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
