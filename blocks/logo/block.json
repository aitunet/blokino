{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tunet/logo",
  "version": "0.1.0",
  "title": "Tunet Logo",
  "category": "design",
  "icon": "format-image",
  "description": "Displays the brand logo (main or alternative) managed in Tunet Core → Logos. Automatic retina via srcset.",
  "keywords": ["logo", "brand"],
  "textdomain": "tunet",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["left", "center", "right", "wide", "full"],
    "spacing": { "margin": true }
  },
  "attributes": {
    "variant": { "type": "string", "default": "main" },
    "maxWidth": { "type": "number", "default": 160 }
  },
  "editorScript": "file:./edit.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
