{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tunet/marquee",
  "version": "0.1.3",
  "title": "Tunet Marquee",
  "category": "design",
  "icon": "controls-repeat",
  "description": "Infinite scrolling band of text or images (logos, claims, metrics). Content is inner blocks; duplicated for a seamless loop.",
  "keywords": ["marquee", "band", "logos", "ticker", "scroll"],
  "textdomain": "tunet",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true },
    "color": { "background": true, "text": true, "gradients": true }
  },
  "attributes": {
    "speed": { "type": "number", "default": 30 },
    "direction": { "type": "string", "default": "left" },
    "gap": { "type": "number", "default": 3 },
    "pauseOnHover": { "type": "boolean", "default": true },
    "separator": { "type": "string", "default": "none" },
    "separatorIcon": { "type": "string", "default": "" },
    "separatorColor": { "type": "string", "default": "" }
  },
  "editorScript": "file:./edit.js",
  "editorStyle": "file:./editor.css",
  "viewScript": "file:./view.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
