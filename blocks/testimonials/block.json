{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tunet/testimonials",
  "version": "0.1.0",
  "title": "Tunet Testimonials",
  "category": "design",
  "icon": "testimonial",
  "description": "Typed testimonials in a carousel or grid. Each item has an avatar, star rating, quote, name and role.",
  "keywords": ["testimonials", "reviews", "quotes", "carousel"],
  "textdomain": "tunet",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "layout": { "type": "string", "default": "carousel" },
    "slidesPerView": { "type": "number", "default": 3 },
    "spaceBetween": { "type": "number", "default": 24 },
    "loop": { "type": "boolean", "default": false },
    "autoplay": { "type": "boolean", "default": false },
    "autoplayDelay": { "type": "number", "default": 5000 },
    "pagination": { "type": "boolean", "default": true },
    "navigation": { "type": "boolean", "default": true },
    "speed": { "type": "number", "default": 600 },
    "columns": { "type": "number", "default": 3 }
  },
  "editorScript": "file:./edit.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
